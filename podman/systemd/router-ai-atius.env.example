# Sample env file for the router-ai-atius Podman stack.
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newapi

# Redis
REDIS_PASSWORD=change-me

# Session secret (must match the new-api Go binary's SESSION_SECRET).
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-32-byte-hex

# Local TEI reliability guardrails. These endpoints are read-only and must be
# reachable from the router container without authentication.
EMBEDDING_GOVERNOR_ENABLED=true
EMBEDDING_GOVERNOR_MODELS=embedding-gte-v1,reranker-gte-v1
EMBEDDING_GOVERNOR_BATCH_MODELS=
EMBEDDING_GOVERNOR_HEALTH_PROBE_ENABLED=true
EMBEDDING_GOVERNOR_HEALTH_PROBE_URL=http://10.21.1.21:31115/health
EMBEDDING_GOVERNOR_HEALTH_BAD_WINDOW_THRESHOLD=1
EMBEDDING_GOVERNOR_CAPACITY_PROBE_ENABLED=true
EMBEDDING_GOVERNOR_CAPACITY_PROBE_URL=http://10.21.1.21:31115/metrics
EMBEDDING_GOVERNOR_CAPACITY_MAX_USED_PERCENT=80

# Optional: override the SQL DSN (defaults to the postgres service above).
# SQL_DSN=postgresql://admin:change-me@db-newapi:5432/newapi?sslmode=disable
# REDIS_CONN_STRING=redis://:change-me@redis-newapi:6379
